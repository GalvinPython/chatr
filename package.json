{
  "name": "@chatr/root",
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.1.20",
  "workspaces": [
    "api",
    "bot",
    "web"
  ],
  "scripts": {
    "dev": "turbo run dev",
